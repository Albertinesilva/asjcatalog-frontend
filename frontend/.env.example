# Copie este arquivo para .env.local e preencha com os dados do seu ambiente.
# O .env.local já é ignorado pelo Git (regra *.local no .gitignore).
#
# ATENÇÃO: toda variável VITE_* é embutida no JavaScript enviado ao navegador.
# Qualquer pessoa pode ler esses valores. Não coloque segredos de verdade aqui.

# Endereço base da API ASJCatalog (sem barra no final).
VITE_API_BASE_URL=http://localhost:SUA-PORTA

# Credenciais do cliente OAuth2 cadastrado na API (usadas no login).
VITE_CLIENT_ID=seu-client-id
VITE_CLIENT_SECRET=seu-client-secret
